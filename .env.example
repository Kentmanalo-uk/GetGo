# Browser-safe values only. Never put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public support contact shown on the partner page and help screens.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=

# --- Edge Function secrets (set with `supabase secrets set`, never in the web build) ---
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
APP_PUBLIC_URL=
